# Neon PostgreSQL connection string
# Dobiti na: https://neon.tech → New Project → Connection string
DATABASE_URL="postgresql://user:password@ep-xxxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth — generisati sa: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Base URL aplikacije (bez trailing slash)
NEXTAUTH_URL="https://your-domain.com"

# Resend email servis — https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM="naSmenu <noreply@your-domain.com>"

# Admin email za notifikacije o novim registracijama
ADMIN_EMAIL="admin@your-domain.com"

# Upstash Redis — rate limiting (opciono, ali obavezno na produkciji)
# Kreirati na: https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

